<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\avatar_echo.png" />
    <None Remove="Assets\avatar_garden.png" />
    <None Remove="Assets\avatar_icarus.png" />
    <None Remove="Assets\avatar_ruby.png" />
    <None Remove="Assets\DOS.ttf" />
    <None Remove="Effects\CrtEffect.ps" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\avatar_garden.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\avatar_echo.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\avatar_icarus.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\avatar_ruby.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\DOS.ttf">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Effects\CrtEffect.ps">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Effects\CrtEffect2.ps">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="Effects\CrtEffect4.ps">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
