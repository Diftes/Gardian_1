<utils:CrtWindow x:Class="Gardian.Views.OsDesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:Gardian.Utils"
        Title="GARDIAN OS" 
        WindowState="Maximized" 
        WindowStyle="None" 
        ResizeMode="NoResize" 
        Topmost="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Aliased"
        RenderOptions.BitmapScalingMode="NearestNeighbor"
        FontFamily="Tahoma, 'MS Sans Serif', sans-serif"
        FontSize="11">

    <!-- ВАЖНО: Используем префикс utils для ресурсов -->
    <utils:CrtWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PresentationFramework.Classic;component/themes/Classic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </utils:CrtWindow.Resources>

    <!-- У окна может быть ТОЛЬКО ОДИН корневой элемент. Это наш Grid. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- РАБОЧИЙ СТОЛ -->
        <Canvas x:Name="DesktopCanvas" Grid.Row="0" Background="{x:Null}">

            <StackPanel Canvas.Left="20" Canvas.Top="20" Width="80" Cursor="Hand" Background="Transparent" MouseDown="Icon_Settings_Click">
                <Rectangle Width="32" Height="32" Fill="#00FF41" RadiusX="4" RadiusY="4" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Settings" Foreground="White" FontFamily="/Gardian;component/Assets/DOS.ttf#PerfectDOSVGA437" FontSize="14" TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <StackPanel Canvas.Left="20" Canvas.Top="130" Width="80" Cursor="Hand" Background="Transparent" MouseDown="Icon_About_Click">
                <Rectangle Width="32" Height="32" Fill="#FFD700" RadiusX="4" RadiusY="4" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="About OS" Foreground="White" FontFamily="/Gardian;component/Assets/DOS.ttf#PerfectDOSVGA437" FontSize="14" TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <StackPanel Canvas.Left="20" Canvas.Top="240" Width="80" Cursor="Hand" Background="Transparent" MouseDown="Icon_TestWindow_Click">
                <Rectangle Width="32" Height="32" Fill="#00FFFF" RadiusX="4" RadiusY="4" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Test Window" Foreground="White" FontFamily="/Gardian;component/Assets/DOS.ttf#PerfectDOSVGA437" FontSize="14" TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <StackPanel Canvas.Left="20" Canvas.Top="350" Width="80" Cursor="Hand" Background="Transparent" MouseDown="Icon_Skype_Click">
                <Rectangle Width="32" Height="32" Fill="#00FFFF" RadiusX="4" RadiusY="4" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Skype" Foreground="White" FontFamily="/Gardian;component/Assets/DOS.ttf#PerfectDOSVGA437" FontSize="14" TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Canvas>

        <!-- ПАНЕЛЬ ЗАДАЧ -->
        <DockPanel Grid.Row="1" x:Name="Taskbar" LastChildFill="False" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <Button x:Name="BtnStart" Content="Start" Width="80" Height="35" DockPanel.Dock="Left" Margin="4,5,4,5"
                    FontFamily="Tahoma" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="Btn_Start_Click"/>

            <Rectangle Width="2" Fill="#808080" DockPanel.Dock="Left" Margin="4,6,0,6"/>
            <Rectangle Width="2" Fill="#FFFFFF" DockPanel.Dock="Left" Margin="0,6,4,6"/>

            <StackPanel x:Name="TaskbarButtons" Orientation="Horizontal" DockPanel.Dock="Left" Margin="4,5,4,5"/>

            <TextBlock x:Name="ClockText" Text="00:00" Foreground="#000000" FontFamily="Tahoma" FontSize="12" 
                       DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,8,8,8" Padding="8,2"/>

            <Button x:Name="BtnSettings" Content="Settings" Width="100" Height="35" DockPanel.Dock="Right" Margin="4,5,4,5"
                    FontFamily="Tahoma" FontSize="12" Cursor="Hand" Click="Btn_Settings_Click"/>
        </DockPanel>
    </Grid>
</utils:CrtWindow>