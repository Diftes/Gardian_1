<Window x:Class="Gardian.Views.PostBootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Gardian.Controls"
        Title="" WindowStyle="None" Background="Black" ShowInTaskbar="True"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown"
        WindowState="Maximized" ResizeMode="NoResize">
    <Grid>
        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Disabled">
            <TextBlock x:Name="BootLog" Foreground="#A8A8A8" FontFamily="Consolas" 
                       FontSize="13" TextWrapping="NoWrap" Padding="16,20" LineHeight="22" Style="{StaticResource GlowingText}"/>
        </ScrollViewer>
        <ProgressBar x:Name="BootBar" Visibility="Collapsed" Height="16" Margin="16" 
                     VerticalAlignment="Bottom" Foreground="#AAAAAA" Background="#1A1A1A"/>
        <!-- ✅ Оверлей поверх всего -->
        
    </Grid>
</Window>