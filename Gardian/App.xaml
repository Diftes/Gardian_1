<Application x:Class="Gardian.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/PostBootWindow.xaml">
    <Application.Resources>

        <!-- ЦВЕТА СВЕЧЕНИЯ ДЛЯ РАЗНЫХ ТЕМ -->
        <Color x:Key="GlowColor">#00FF41</Color>
        <!-- По умолчанию Green -->

        <Style x:Key="GlowingText" TargetType="TextBlock">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect 
                        Color="{DynamicResource GlowColor}" 
                        BlurRadius="4" 
                        ShadowDepth="0" 
                        Opacity="0.8" 
                        RenderingBias="Performance"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ГЛОБАЛЬНЫЙ СТИЛЬ ДЛЯ ВСЕХ ОКОН -->

            <Style TargetType="Window">
            <Setter Property="WindowState" Value="Maximized"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="Topmost" Value="True"/>
            <Setter Property="ShowInTaskbar" Value="False"/>
        </Style>
    </Application.Resources>
</Application>




