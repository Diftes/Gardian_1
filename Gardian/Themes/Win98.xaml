<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Цвета -->
    <SolidColorBrush x:Key="WindowBrush" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="TextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="#000080"/>
    <SolidColorBrush x:Key="HighlightTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#808080"/>

    <!-- Шрифт -->
    <FontFamily x:Key="ThemeFont">Tahoma, 'MS Sans Serif', sans-serif</FontFamily>
    <sys:Double x:Key="ThemeFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>

    <!-- Стиль кнопки Win98 (3D-рамки) -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource ThemeFont}"/>
        <Setter Property="FontSize" Value="{StaticResource ThemeFontSize}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="#FFFFFF" BorderThickness="2,2,0,0">
                        <Border BorderBrush="#808080" BorderThickness="0,0,2,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,2,4,4"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль TextBox Win98 -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontFamily" Value="{StaticResource ThemeFont}"/>
        <Setter Property="FontSize" Value="{StaticResource ThemeFontSize}"/>
    </Style>

    <!-- Стиль TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource ThemeFont}"/>
        <Setter Property="FontSize" Value="{StaticResource ThemeFontSize}"/>
    </Style>

    <!-- Стиль ListBox -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

</ResourceDictionary>