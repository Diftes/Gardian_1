<UserControl x:Class="Gardian.Controls.CrtPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:effects="clr-namespace:Gardian.Effects"
             Width="320" Height="240">

    <Border Background="#000000" BorderBrush="#333" BorderThickness="2" CornerRadius="4">
        <Grid>
            <!-- Шейдер применяется ко всему содержимому Grid -->
            <Grid.Effect>
                <effects:CrtShaderEffect x:Name="PreviewEffect"
                                         Time="0" Scale="2" Resolution="320,240"
                                         EnableDistortion="1" EnableNoise="1" EnableChromatic="1"
                                         EnableBlur="1" EnableScanline="1" GlowStrength="0.4"/>
            </Grid.Effect>

            <!-- РЕЖИМ 1: TV Test Pattern (Цветные полосы) -->
            <Grid x:Name="ViewTestPattern" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Fill="#FFFFFF"/>
                <Rectangle Grid.Column="1" Fill="#FFFF00"/>
                <Rectangle Grid.Column="2" Fill="#00FFFF"/>
                <Rectangle Grid.Column="3" Fill="#00FF00"/>
                <Rectangle Grid.Column="4" Fill="#FF00FF"/>
                <Rectangle Grid.Column="5" Fill="#FF0000"/>
                <Rectangle Grid.Column="6" Fill="#0000FF"/>
                <Rectangle Grid.Column="7" Fill="#000000"/>

                <!-- Полоса для теста шума/глитча снизу -->
                <Rectangle Height="30" VerticalAlignment="Bottom" Grid.ColumnSpan="8" Fill="#444444" Opacity="0.8"/>
            </Grid>

            <!-- РЕЖИМ 2: RGB Text (Для теста свечения и хроматики) -->
            <Grid x:Name="ViewRgbText" Visibility="Collapsed" Margin="15">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RED CHANNEL TEST" Foreground="#FF3333" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="GREEN CHANNEL TEST" Foreground="#33FF33" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="BLUE CHANNEL TEST" Foreground="#3333FF" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="WHITE / BRIGHTNESS" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="CYAN / YELLOW MIX" Foreground="#FFFF33" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Margin="0,4"/>
                </StackPanel>
            </Grid>

            <!-- РЕЖИМ 3: Theme Placeholder -->
            <Grid x:Name="ViewTheme" Visibility="Collapsed" Background="#111111">
                <TextBlock Text="THEME PREVIEW&#x0a;(Coming Soon)" 
                           Foreground="#555555" FontFamily="Consolas" FontSize="14" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>